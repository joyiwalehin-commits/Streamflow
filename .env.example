# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Secret key from Paystack Dashboard (e.g. sk_test_... or sk_live_...).
# Strictly kept on the server/backend to initialize and verify payments in Nigerian Naira (NGN).
PAYSTACK_SECRET_KEY=

# STREAMING_PROVIDER: Selected live video streaming provider ("livekit" | "agora" | "mux" | "auto"). Defaults to auto-detecting configured provider.
STREAMING_PROVIDER=

# LIVEKIT CONFIGURATION: WebRTC SFU for sub-second ultra-low-latency interactive live streaming, multi-guest, and PK battles.
# Get free cloud credentials at https://cloud.livekit.io or self-host LiveKit Server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AGORA CONFIGURATION: Real-time engagement SDK for mobile/web live video broadcasting and interactive co-hosting.
# Get credentials from Agora Developer Console at https://console.agora.io.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# MUX VIDEO CONFIGURATION: Broadcast-grade RTMP/WHIP live ingestion and low-latency HLS/WHEP streaming.
# Get credentials at https://dashboard.mux.com.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
